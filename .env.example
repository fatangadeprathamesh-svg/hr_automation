# Environment Configuration for Month-End HR Self-Audit Assistant
# Copy to .env and adjust variables as required.

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=change-this-insecure-secret-key-for-dev-only-32bytesmin
ORGANIZATION_ID=ORG_DEMO_01
DEFAULT_TIMEZONE=America/New_York

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://hr_audit_user:hr_audit_password@localhost:5432/hr_audit_db
# For lightweight local testing without Docker, uncomment SQLite fallback:
# DATABASE_URL=sqlite:///./hr_audit.db

# Object Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RECEIPTS=hr-receipts
MINIO_BUCKET_PACKS=hr-audit-packs

# Service Authentication (For n8n Orchestrator)
N8N_SERVICE_API_KEY=n8n_secret_service_token_dev_placeholder
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Optional Crustdata Integration (Disabled by default)
CRUSTDATA_ENABLED=false
CRUSTDATA_API_KEY=crustdata_key_placeholder
CRUSTDATA_BASE_URL=https://api.crustdata.com
